# From Waboom dashboard -> WhatsApp Cloud API settings (same values Meta issues)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Only change this if Waboom gives you a different gateway URL than Meta's Graph API.
# Default talks directly to Meta's Graph API using your token above.
WHATSAPP_API_BASE=https://graph.facebook.com

# Name of an approved message template (required for the first message to a
# contact / any contact outside your 24h customer service window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Messages per second. WhatsApp Cloud API default tier is ~80 msg/sec but new
# numbers start much lower (often 250 conversations/24h). Keep this low.
BLAST_RATE_PER_SECOND=1
